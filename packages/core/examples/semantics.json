{
  "version": 1,
  "name": "Cross-language semantics check",
  "main": [
    { "id": "c0", "kind": "comment", "text": "Every line here is a place where languages disagree by default." },
    { "id": "d1", "kind": "declare", "name": "r", "type": "real" },
    { "id": "d2", "kind": "declare", "name": "n", "type": "int" },
    { "id": "d3", "kind": "declare", "name": "ok", "type": "bool" },
    { "id": "d4", "kind": "declare", "name": "s", "type": "string" },
    { "id": "d5", "kind": "declare", "name": "words", "type": "string", "size": "2" },

    { "id": "m1", "kind": "output", "value": "\"-7 % 3 = \" + (-7 % 3)" },
    { "id": "m2", "kind": "output", "value": "\"7 % -3 = \" + (7 % -3)" },
    { "id": "m3", "kind": "output", "value": "\"-7 div 2 = \" + (-7 div 2)" },
    { "id": "m4", "kind": "output", "value": "\"5.5 % 2 = \" + (5.5 % 2)" },

    { "id": "r1", "kind": "output", "value": "\"round(2.5) = \" + round(2.5)" },
    { "id": "r2", "kind": "output", "value": "\"round(-2.5) = \" + round(-2.5)" },
    { "id": "r3", "kind": "output", "value": "\"round(3.49) = \" + round(3.49)" },
    { "id": "r4", "kind": "output", "value": "\"floor(-1.5) = \" + floor(-1.5) + \", ceil(-1.5) = \" + ceil(-1.5)" },

    { "id": "f1", "kind": "assign", "target": "r", "value": "7 / 2" },
    { "id": "f2", "kind": "output", "value": "r" },
    { "id": "f3", "kind": "assign", "target": "r", "value": "10 / 4" },
    { "id": "f4", "kind": "output", "value": "\"10 / 4 = \" + r" },
    { "id": "f5", "kind": "assign", "target": "r", "value": "8 / 2" },
    { "id": "f6", "kind": "output", "value": "\"8 / 2 = \" + r" },
    { "id": "f7", "kind": "output", "value": "\"1 / 3 = \" + 1 / 3" },
    { "id": "f8", "kind": "output", "value": "\"sqrt(16) = \" + sqrt(16)" },
    { "id": "f9", "kind": "output", "value": "\"pow(2, 10) = \" + pow(2, 10)" },
    { "id": "f10", "kind": "output", "value": "\"2 ^ 10 = \" + 2 ^ 10" },
    { "id": "f11", "kind": "output", "value": "\"-2 ^ 2 = \" + -2 ^ 2" },
    { "id": "f12", "kind": "output", "value": "\"2 ^ 3 ^ 2 = \" + 2 ^ 3 ^ 2" },
    { "id": "f13", "kind": "assign", "target": "r", "value": "1 / 100000" },
    { "id": "f14", "kind": "output", "value": "\"small = \" + r" },
    { "id": "f15", "kind": "assign", "target": "r", "value": "r / 100" },
    { "id": "f16", "kind": "output", "value": "\"smaller = \" + r" },
    { "id": "f17", "kind": "assign", "target": "r", "value": "0.1 + 0.2" },
    { "id": "f18", "kind": "output", "value": "\"0.1 + 0.2 = \" + r" },
    { "id": "f19", "kind": "assign", "target": "r", "value": "2" },
    { "id": "f20", "kind": "output", "value": "\"real holding 2 = \" + r" },
    { "id": "f21", "kind": "output", "value": "r * 1.5" },

    { "id": "b1", "kind": "assign", "target": "ok", "value": "not (3 > 2) or 1 == 1 and \"b\" > \"a\"" },
    { "id": "b2", "kind": "output", "value": "ok" },
    { "id": "b3", "kind": "output", "value": "\"ok = \" + ok" },
    { "id": "b4", "kind": "output", "value": "not ok" },
    { "id": "b5", "kind": "output", "value": "(1 < 2) == true" },

    { "id": "s1", "kind": "assign", "target": "s", "value": "\"ab\" + 1 + 2" },
    { "id": "s2", "kind": "output", "value": "s" },
    { "id": "s3", "kind": "output", "value": "1 + 2 + \"ab\"" },
    { "id": "s4", "kind": "output", "value": "upper(s) + lower(\"XY\") + len(s) + toString(2.50)" },
    { "id": "s5", "kind": "assign", "target": "n", "value": "toInt(\"42\") + len(\"héllo\")" },
    { "id": "s6", "kind": "output", "value": "n" },
    { "id": "s7", "kind": "assign", "target": "words", "index": "0", "value": "\"ünlü\"" },
    { "id": "s8", "kind": "assign", "target": "words", "index": "1", "value": "upper(words[0])" },
    { "id": "s9", "kind": "output", "value": "words[0] + \" \" + words[1] + \" \" + len(words)" },
    { "id": "s10", "kind": "output", "value": "\"tab\\there\\n\\\"quoted\\\"\"" },
    { "id": "s11", "kind": "output", "value": "\"s[1] = \" + s[1] + \", last = \" + s[len(s) - 1] + \", words[1][0] via assign below\"" },
    { "id": "s12", "kind": "assign", "target": "s", "value": "words[1]" },
    { "id": "s13", "kind": "output", "value": "s[0] + s[0] == \"ÜÜ\"" },

    { "id": "e1", "kind": "output", "value": "\"max(3, 2.5) = \" + max(3, 2.5) + \", min(-1, 4) = \" + min(-1, 4) + \", abs(-2.5) = \" + abs(-2.5)" },
    { "id": "e2", "kind": "output", "value": "1 - 2 - 3" },
    { "id": "e3", "kind": "output", "value": "1 - (2 - 3)" },
    { "id": "e4", "kind": "output", "value": "2 * (3 + 4) % 5" }
  ],
  "functions": []
}
